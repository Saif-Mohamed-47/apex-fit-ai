DATABASE_URL=postgresql://user:password@localhost:5433/dbname_here

# Security (Generate secret with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me

# LLM Provider selection: "ollama" or "gemini"
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=30.0

# Ollama Provider settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gemini Provider settings (Required when LLM_PROVIDER=gemini)
# NOTE: Real generate call hit transient 429/503 limits on Google API. Verified available Flash model: gemini-3.8-flash.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

